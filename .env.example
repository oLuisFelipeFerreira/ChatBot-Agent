# Copie este arquivo para ".env" e preencha com os seus valores.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Nunca commite o ".env" (ele ja esta no .gitignore).
#
# Voce escolhe UM provedor. Descomente o bloco que quiser e comente os outros.
# Os embeddings (a busca nos documentos) rodam sempre LOCAL, de graca --
# nada disso aqui afeta a indexacao, so a geracao da resposta. Trocar de
# modelo NAO obriga a reindexar.

# --- Google Gemini (padrao): camada gratuita ---------------------------
# Ja vem instalado. Pegue a chave em https://aistudio.google.com/apikey
#
# CUIDADO COM A COTA: na camada gratuita ela e contada em REQUISICOES POR
# DIA e varia MUITO por modelo. Medido em out/2026, gemini-3.8-flash da
# apenas 20 req/dia -- com multi-query ligado isso vira 10 perguntas.
# Os modelos "-lite" costumam ter cota bem maior e sao a escolha certa
# para um site publico. Confira em https://ai.dev/rate-limit
#
# Modelos sao APOSENTADOS com o tempo. Se um dia aparecer
# "404 ... is no longer available", a propria mensagem diz o substituto:
# troque o LLM_MODEL aqui. Nao e erro de codigo.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.8-flash
GOOGLE_API_KEY=cole-sua-chave-aqui

# --- Ollama: 100% local, sem chave e sem custo -------------------------
# Instale o Ollama (https://ollama.com), rode "ollama pull llama3.1" e
# "pip install langchain-ollama". Depois use:
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# --- Groq: camada gratuita, modelos abertos e muito rapidos ------------
# pip install langchain-groq   |   chave em https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=cole-sua-chave-aqui

# --- Anthropic: pago, ja vem instalado ---------------------------------
# Chave em https://console.anthropic.com/settings/keys
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=cole-sua-chave-aqui

# --- OpenAI: pago ------------------------------------------------------
# pip install langchain-openai
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=cole-sua-chave-aqui


# ===== Limites de uso (protegem a sua cota quando o site esta no ar) ====
# Quantas perguntas cada visitante pode fazer por minuto:
LIMITE_POR_MINUTO=6

# Teto diario do site inteiro. REGRA: deixe ABAIXO da cota do seu provedor,
# para que QUEM diga "nao" seja a sua aplicacao, com uma mensagem decente,
# e nao o provedor com um erro cru no meio da resposta.
# Se multi-query estiver ligado, cada pergunta gasta DUAS requisicoes --
# entao o teto em perguntas e metade da cota em requisicoes.
LIMITE_POR_DIA=300

# Multi-query: o modelo reescreve a pergunta antes de buscar. Melhora a
# recuperacao e DOBRA o consumo de cota.
#   1 = ligado   (recomendado no seu computador, com cota folgada)
#   0 = desligado (recomendado no servidor publico, em camada gratuita)
USAR_MULTIQUERY=1
# Ponha como 1 SOMENTE se houver nginx/Cloudflare na frente da aplicacao.
# Fora de um proxy, isto deixaria qualquer um furar o limite.
ATRAS_DE_PROXY=0
