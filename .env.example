# Copie este arquivo para ".env" e ajuste se precisar.
#   Linux/macOS:  cp .env.example .env
#   Windows:      copy .env.example .env
# Nunca commite o ".env" (ele ja esta no .gitignore).
#
# Do jeito que vem, este arquivo FUNCIONA SEM CHAVE NENHUMA: o modelo roda
# na sua propria maquina, via Ollama. Nao ha cota, custo nem cadastro.
#
# A busca nos documentos (embeddings + FAISS + BM25) e SEMPRE local e
# gratuita, em qualquer configuracao. Trocar de modelo nao obriga a
# reindexar nada.

# --- Ollama (padrao): local, sem chave, sem custo ----------------------
# 1. Instale: https://ollama.com/download
# 2. Baixe o modelo: ollama pull llama3.2:3b
# Pronto. Nao precisa de mais nada.
#
# Honestamente: e mais lento e obedece as regras do prompt com menos
# consistencia que uma API. Medido neste projeto, num i5 de notebook sem
# placa de video: ~45s por pergunta com TOP_K=4. Veja a comparacao de
# qualidade no README.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b

# Janela de contexto do Ollama. O padrao dele e PEQUENO e corta o prompt
# EM SILENCIO quando o contexto nao cabe -- sem erro e sem aviso. O
# sintoma e "o modelo e burro"; a causa e que ele nunca recebeu o texto
# inteiro. Mantenha folga.
OLLAMA_NUM_CTX=8192

# --- Google Gemini: camada gratuita, muito mais rapido -----------------
# Ja vem instalado. Chave em https://aistudio.google.com/apikey
#
# CUIDADO COM A COTA: na camada gratuita ela e contada em REQUISICOES POR
# DIA e varia MUITO por modelo. Medido em out/2026, gemini-3.8-flash da
# apenas 20 req/dia. Os modelos "-lite" costumam ter cota bem maior.
# Modelos tambem sao APOSENTADOS: se aparecer "404 ... is no longer
# available", a propria mensagem diz o substituto. Nao e erro de codigo.
# LLM_PROVIDER=google_genai
# LLM_MODEL=gemini-3.8-flash
# GOOGLE_API_KEY=cole-sua-chave-aqui

# --- Groq: camada gratuita, modelos abertos e rapidos ------------------
# pip install langchain-groq   |   chave em https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=cole-sua-chave-aqui

# --- Anthropic / OpenAI: pagos -----------------------------------------
# LLM_PROVIDER=anthropic   LLM_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_API_KEY=...
# pip install langchain-openai
# LLM_PROVIDER=openai      LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=...


# ===== Ajustes de desempenho ===========================================
# Quantos trechos de documento vao no prompt a cada pergunta.
#
# Este e o numero que MAIS pesa na espera. Medido: o modelo gasta a maior
# parte do tempo LENDO o contexto, nao escrevendo a resposta. Com o modelo
# local, TOP_K=10 levou ~60s e TOP_K=4 levou ~22s.
#   4  = rapido, menos contexto (bom para modelo local)
#   10 = mais contexto (bom para API rapida)
TOP_K=4

# Multi-query: o modelo reescreve a pergunta antes de buscar. Melhora a
# recuperacao e DOBRA o numero de chamadas por pergunta.
#   1 = ligado    (cota folgada)
#   0 = desligado (camada gratuita ou modelo local lento)
USAR_MULTIQUERY=0


# ===== Limites de uso (protegem a sua cota quando o site esta no ar) ====
# Quantas perguntas cada visitante pode fazer por minuto:
LIMITE_POR_MINUTO=6

# Teto diario do site inteiro. REGRA: deixe ABAIXO da cota do seu
# provedor, para que QUEM diga "nao" seja a sua aplicacao, com uma
# mensagem decente, e nao o provedor com um erro cru no meio da resposta.
LIMITE_POR_DIA=300

# Ponha como 1 SOMENTE se houver nginx/Cloudflare na frente da aplicacao.
# Fora de um proxy, isto deixaria qualquer um furar o limite.
ATRAS_DE_PROXY=0
